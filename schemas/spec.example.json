  "feature_requirements": [
    {
      "feature_id": "feat_001",
      "name": "Job Quoting Screen",
      "type": "screen",
      "_section_render": ["customer", "dev"],
      "description": "Allows sales staff to build a cost estimate by selecting parts and quantities, with BOM costs rolling up automatically.",
      "user_roles": ["sales_coordinator", "estimator"],
      "data_entity_refs": ["ent_purchase_order", "ent_bom", "ent_part"],
      "workflow_step_refs": ["wf_001_s01", "wf_001_s02"],
      "business_justification": "Addresses pain point pp_001: reduces quote cycle time from 2–3 days to under 4 hours by surfacing BOM costs inline.",
      "priority": "P1",
      "effort_estimate": "medium",
      "acceptance_criteria": [
        "User can search and select parts by part number or description",
        "Cost rolls up automatically from BOM with current standard material prices",
        "Quote can be exported as PDF and emailed directly to customer",
        "Draft quotes auto-save every 30 seconds"
      ],
      "ui_notes": {
        "_render": ["dev"],
        "layout": "two_panel",
        "primary_actions": ["save_draft", "submit_for_approval", "export_pdf"]
      }
    },
    {
      "feature_id": "feat_002",
      "name": "Real-Time Inventory Dashboard",
      "type": "dashboard_widget",
      "_section_render": ["customer", "dev"],
      "description": "Displays on-hand inventory levels by part and location, with low-stock alerts.",
      "user_roles": ["shop_floor_supervisor", "admin"],
      "data_entity_refs": ["ent_inventory", "ent_part"],
      "workflow_step_refs": ["wf_001_s03"],
      "business_justification": "Addresses pain point pp_002: gives supervisors real-time visibility so they can set accurate delivery dates.",
      "priority": "P1",
      "effort_estimate": "small",
      "acceptance_criteria": [
        "Shows current quantity on hand and quantity reserved per part",
        "Highlights parts below reorder point in red",
        "Refreshes automatically every 60 seconds",
        "Exportable to CSV"
      ],
      "ui_notes": {
        "_render": ["dev"],
        "layout": "table",
        "primary_actions": ["filter_by_location", "export_csv", "set_reorder_point"]
      }
    },
    {
      "feature_id": "feat_003",
      "name": "Automatic Invoice Generation",
      "type": "background_job",
      "_section_render": ["customer", "dev"],
      "description": "On shipment dispatch, automatically creates an invoice from the job order and pushes it to QuickBooks Online.",
      "user_roles": ["admin"],
      "data_entity_refs": ["ent_shipment", "ent_invoice", "ent_purchase_order"],
      "workflow_step_refs": ["wf_002_s01", "wf_002_s02"],
      "business_justification": "Addresses pain point pp_003: eliminates 3–5 day delay in invoicing and removes manual double-entry.",
      "priority": "P1",
      "effort_estimate": "medium",
      "acceptance_criteria": [
        "Invoice is created within 60 seconds of shipment status changing to dispatched",
        "Invoice line items match shipped quantities exactly",
        "Invoice is pushed to QuickBooks and the QBO ID is stored on the ERP invoice record",
        "Failed sync is retried up to 3 times with alerts on final failure"
      ],
      "ui_notes": null
    },
    {
      "feature_id": "feat_004",
      "name": "Shop Floor Job Board",
      "type": "screen",
      "_section_render": ["customer", "dev"],
      "description": "Kanban-style view of all active job orders by status, allowing supervisors to update progress.",
      "user_roles": ["shop_floor_supervisor"],
      "data_entity_refs": ["ent_job_order", "ent_purchase_order"],
      "workflow_step_refs": ["wf_001_s03"],
      "business_justification": "Replaces the current whiteboard + spreadsheet system for tracking shop floor jobs.",
      "priority": "P1",
      "effort_estimate": "medium",
      "acceptance_criteria": [
        "Displays job orders grouped by status columns (Released, In Progress, On Hold, Completed)",
        "Supervisor can drag cards between columns to update status",
        "Shows due date and customer name on each card",
