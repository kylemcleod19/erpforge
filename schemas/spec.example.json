  "integration_points": [
    {
      "integration_id": "int_001",
      "name": "QuickBooks Online",
      "vendor": "Intuit",
      "category": "accounting",
      "_section_render": ["customer", "dev", "api"],
      "description": "Syncs invoices and payments bidirectionally between the ERP and QuickBooks Online.",
      "auth_method": {
        "_value": "oauth2_authorization_code",
        "_render": ["dev", "api"],
        "_label": "Authentication Method"
      },
      "auth_config": {
        "_render": ["dev", "api"],
        "scopes": ["com.intuit.quickbooks.accounting"],
        "token_endpoint": "https://oauth.platform.intuit.com/oauth2/v1/tokens/bearer",
        "refresh_strategy": "automatic_on_expiry"
      },
      "endpoints": [
        {
          "endpoint_id": "int_001_ep01",
          "_render": ["dev", "api"],
          "direction": "outbound",
          "purpose": "Create invoice in QBO from ERP shipment dispatch",
          "method": "POST",
          "path": "/v3/company/{realmId}/invoice",
          "trigger": "workflow_step",
          "trigger_ref": "wf_002_s02",
          "request_payload_entity_refs": ["ent_invoice"],
          "response_handling": {
            "success_action": "update_field",
            "field_path": "ent_invoice.external_qbo_id",
            "failure_action": "retry_with_backoff",
            "max_retries": 3
          }
        },
        {
          "endpoint_id": "int_001_ep02",
          "_render": ["dev", "api"],
          "direction": "inbound",
          "purpose": "Receive payment status updates from QBO via webhook",
          "method": "WEBHOOK",
          "path": "/api/v1/webhooks/qbo",
          "trigger": "webhook",
          "request_payload_entity_refs": ["ent_invoice"],
          "response_handling": {
            "success_action": "update_field",
            "field_path": "ent_invoice.status",
            "failure_action": "dead_letter",
            "max_retries": 0
          }
        }
      ],
      "sync_frequency": "event_driven",
      "data_mapping": [
        {
          "erp_entity_field": "ent_invoice.total_amount",
          "external_field": "Invoice.TotalAmt",
          "transform": "none"
        },
        {
          "erp_entity_field": "ent_invoice.due_date",
          "external_field": "Invoice.DueDate",
          "transform": "format_date",
          "transform_detail": "ISO 8601 to YYYY-MM-DD"
        },
        {
          "erp_entity_field": "ent_customer.name",
          "external_field": "Invoice.CustomerRef.name",
          "transform": "none"
        }
      ],
      "error_strategy": "dead_letter_queue_with_alert",
      "business_justification": "Eliminates double-entry of invoices which currently costs ~3 hours/week and reduces payment reconciliation errors."
    },
    {
      "integration_id": "int_002",
      "name": "FedEx Ship Manager",
      "vendor": "FedEx",
      "category": "shipping",
      "_section_render": ["customer", "dev", "api"],
      "description": "Creates shipping labels and retrieves tracking numbers when a shipment is dispatched.",
      "auth_method": {
        "_value": "oauth2_client_credentials",
        "_render": ["dev", "api"],
        "_label": "Authentication Method"
      },
      "auth_config": {
        "_render": ["dev", "api"],
        "token_endpoint": "https://apis.fedex.com/oauth/token",
        "refresh_strategy": "automatic_on_expiry"
      },
      "endpoints": [
        {
          "endpoint_id": "int_002_ep01",
          "_render": ["dev", "api"],
          "direction": "outbound",
          "purpose": "Create shipping label and get tracking number",
          "method": "POST",
          "path": "/ship/v1/shipments",
          "trigger": "workflow_step",
          "trigger_ref": "wf_002_s01",
          "request_payload_entity_refs": ["ent_shipment"],
          "response_handling": {
            "success_action": "update_field",
            "field_path": "ent_shipment.tracking_number",
            "failure_action": "alert",
            "max_retries": 2
          }
        }
      ],
      "sync_frequency": "event_driven",
      "data_mapping": [
        {
          "erp_entity_field": "ent_shipment.tracking_number",
          "external_field": "output.transactionShipments[0].masterTrackingNumber",
          "transform": "none"
        }
      ],
      "error_strategy": "retry_with_backoff",
      "business_justification": "Eliminates manual label printing and automatic populates tracking numbers on shipment records and customer notifications."
    }
  ],

  "ai_touchpoints": [
    {
      "touchpoint_id": "ai_001",
      "name": "PO Line Item Extraction",
      "agent_type": "auto_draft",
      "_section_render": ["customer", "dev"],
      "description": "When a customer PDF purchase order is uploaded, the agent reads it and pre-fills all line item fields, reducing manual data entry.",
      "step_refs": ["wf_001_s01"],
      "trigger": {
        "event": "file_uploaded",
        "condition": "file.mime_type == 'application/pdf' AND context == 'purchase_order_intake'"
      },
      "input_context": {
        "provided_to_agent": ["uploaded_file_content", "ent_customer.preferred_part_numbers", "ent_part.catalog"],
        "context_window_strategy": "rag_from_part_catalog"
      },
      "expected_output": {
        "format": "structured_json",
        "target_entity_ref": "ent_purchase_order",
        "fields_populated": ["line_items", "requested_ship_date", "po_number"]
      },
      "human_in_the_loop": {
        "required": true,
        "review_before_commit": true,
        "diff_display": true
      },
      "fallback": {
        "strategy": "graceful_degrade",
        "description": "If confidence < 0.85, flag individual fields for manual review rather than blocking the entire form"
      },
      "confidence_threshold": 0.85,
      "model_preference": "claude-sonnet",
      "business_justification": "Addresses pain point pp_001: eliminates manual re-typing of incoming PDFs, which is the primary source of quoting delay."
    },
    {
      "touchpoint_id": "ai_002",
      "name": "PO Anomaly Validator",
      "agent_type": "validation",
      "_section_render": ["customer", "dev"],
      "description": "When a PO is submitted for confirmation, the agent checks for anomalies: unusually low prices, parts the customer has never ordered before, quantities far outside historical norms.",
      "step_refs": ["wf_001_s02"],
      "trigger": {
        "event": "po_status_changed",
        "condition": "new_status == 'confirmed'"
      },
      "input_context": {
        "provided_to_agent": ["ent_purchase_order", "ent_customer.order_history_summary", "ent_part.price_history"],
        "context_window_strategy": "entity_snapshot"
      },
      "expected_output": {
        "format": "structured_json",
        "target_entity_ref": "ent_purchase_order",
        "fields_populated": ["anomaly_flags", "anomaly_summary"]
      },
      "human_in_the_loop": {
        "required": false,
        "review_before_commit": false,
        "diff_display": false
      },
      "fallback": {
        "strategy": "skip_and_notify",
        "description": "If the agent fails, log the error and proceed with confirmation — do not block the workflow"
      },
      "confidence_threshold": 0.75,
      "model_preference": "claude-haiku",
      "business_justification": "Catches pricing errors and unusual orders before they reach the shop floor, reducing costly rework."
    },
    {
      "touchpoint_id": "ai_003",
      "name": "Invoice Reconciliation Assistant",
      "agent_type": "summarization",
      "_section_render": ["customer", "dev"],
      "description": "When a payment webhook arrives from QuickBooks, the agent reconciles it against open invoices and generates a human-readable payment summary for the accounting team.",
      "step_refs": ["wf_002_s02"],
      "trigger": {
        "event": "webhook_received",
        "condition": "webhook.source == 'qbo' AND webhook.event_type == 'Payment.Create'"
      },
      "input_context": {
        "provided_to_agent": ["webhook_payload", "ent_invoice.open_invoices_for_customer"],
        "context_window_strategy": "entity_snapshot"
      },
      "expected_output": {
        "format": "markdown_text",
        "target_entity_ref": "ent_invoice",
        "fields_populated": ["reconciliation_note"]
      },
      "human_in_the_loop": {
        "required": false,
        "review_before_commit": false,
        "diff_display": false
      },
      "fallback": {
        "strategy": "skip_and_notify",
        "description": "If the agent fails, record the raw webhook payload and notify the accounting team to reconcile manually"
      },
      "confidence_threshold": 0.9,
      "model_preference": "claude-haiku",
      "business_justification": "Reduces the time accounting spends manually matching payments to invoices in QBO."
    }
  ],

  "development_standards": {
    "_section_render": ["dev", "api"],
    "api_style": "rest_json",
    "api_versioning_strategy": "url_prefix",
    "api_base_path": "/api/v1",
    "auth_mechanism": "jwt_bearer",
    "architecture_pattern": "modular_monolith",
    "database_type": "relational",
    "orm_preference": "tbd",
    "test_coverage_threshold": 80,
    "roles": [
      { "role_id": "sales_coordinator", "display_name": "Sales Coordinator", "description": "Handles incoming orders and customer communication" },
      { "role_id": "estimator", "display_name": "Estimator", "description": "Builds cost quotes from BOMs" },
      { "role_id": "shop_floor_supervisor", "display_name": "Shop Floor Supervisor", "description": "Manages production job assignments and shop floor status" },
      { "role_id": "shipping_clerk", "display_name": "Shipping Clerk", "description": "Records outbound shipments and prints labels" },
      { "role_id": "admin", "display_name": "System Administrator", "description": "Full access to all modules and configuration" }
    ],
    "documentation_rules": {
      "require_jsdoc_on_public_functions": true,
      "require_openapi_for_all_endpoints": true,
      "require_entity_relationship_diagram": true,
      "inline_comment_style": "explain_why_not_what"
    },
    "api_conventions": {
      "id_format": "uuid_v4",
      "timestamp_format": "ISO_8601_UTC",
      "pagination_style": "cursor",
      "error_envelope": {
        "_render": ["dev", "api"],
        "shape": "{ code: string, message: string, details: object[], request_id: string }"
      },
      "success_envelope": {
        "_render": ["dev", "api"],
        "shape": "{ data: T, meta: { total?: number, cursor_next?: string } }"
      }
    },
    "text_blocks": [
      {
        "block_id": "tb_001",
        "title": "Naming Conventions",
        "audience": ["dev"],
        "content": "Database columns use snake_case. TypeScript types and interfaces use PascalCase. API endpoints use kebab-case nouns (plural). Boolean fields are prefixed with is_ or has_. Event names use past tense (po_confirmed, shipment_dispatched)."
      },
      {
        "block_id": "tb_002",
        "title": "Module Boundaries",
        "audience": ["dev"],
        "content": "Each core workflow maps to one module directory (orders/, production/, fulfillment/, billing/). Modules may not import directly from sibling modules — all cross-module calls go through a shared service interface layer at src/services/. Shared domain types live in src/domain/."
      },
      {
        "block_id": "tb_003",
        "title": "Error Handling Policy",
        "audience": ["dev", "api"],
        "content": "All errors thrown from service layer must be typed (OrderNotFoundError, ValidationError, etc.) and map to a specific HTTP status code in the API layer. Never catch and swallow errors silently. Integration errors are logged to the dead-letter queue before re-throwing."
      },
      {
        "block_id": "tb_004",
        "title": "Testing Requirements",
        "audience": ["dev"],
        "content": "Unit tests cover business logic in service layer. Integration tests hit a real test database (no mocks for DB calls). E2E tests cover the happy path for each core workflow. Test files live alongside source files using .test.ts suffix."
      }
    ]
  },

