  "core_workflows": [
    {
      "workflow_id": "wf_001",
      "name": "Order Intake to Production Release",
      "_section_render": ["customer", "dev"],
      "description": "Covers the path from receiving a customer purchase order through releasing a job to the shop floor.",
      "steps": [
        {
          "step_id": "wf_001_s01",
          "sequence": 1,
          "name": "Receive Customer PO",
          "_label": "Customer sends purchase order",
          "actor": { "type": "human", "role": "sales_coordinator" },
          "action": "log_incoming_po",
          "system": "erp_orders_module",
          "inputs": [
            { "entity_ref": "ent_purchase_order", "source": "email_or_upload" }
          ],
          "outputs": [
            { "entity_ref": "ent_purchase_order", "state": "draft" }
          ],
          "rules": [
            {
              "rule_id": "r_001",
              "type": "required_field",
              "description": "PO must include customer_id, line items with part numbers, and requested ship date"
            }
          ],
          "ai_touchpoint_ref": "ai_001",
          "estimated_frequency": "daily",
          "notes": "Currently done via email + manual data entry into a spreadsheet"
        },
        {
          "step_id": "wf_001_s02",
          "sequence": 2,
          "name": "Review and Confirm PO",
          "_label": "Sales reviews and confirms order",
          "actor": { "type": "human", "role": "sales_coordinator" },
          "action": "confirm_po",
          "system": "erp_orders_module",
          "inputs": [
            { "entity_ref": "ent_purchase_order", "state": "draft" }
          ],
          "outputs": [
            { "entity_ref": "ent_purchase_order", "state": "confirmed" }
          ],
          "rules": [
            {
              "rule_id": "r_002",
              "type": "validation",
              "description": "All line items must resolve to a known part number in the catalog"
            },
            {
              "rule_id": "r_003",
              "type": "conditional",
              "description": "If order total > $10,000, require estimator approval before confirming"
            }
          ],
          "ai_touchpoint_ref": "ai_002",
          "estimated_frequency": "daily",
          "notes": null
        },
        {
          "step_id": "wf_001_s03",
          "sequence": 3,
          "name": "Release Job to Shop Floor",
          "_label": "Job released to production",
          "actor": { "type": "human", "role": "shop_floor_supervisor" },
          "action": "release_job",
          "system": "erp_production_module",
          "inputs": [
            { "entity_ref": "ent_purchase_order", "state": "confirmed" },
            { "entity_ref": "ent_bom", "source": "part_catalog" }
          ],
          "outputs": [
            { "entity_ref": "ent_job_order", "state": "released" }
          ],
          "rules": [
            {
              "rule_id": "r_004",
              "type": "system_check",
              "description": "Inventory on-hand for all BOM components must be sufficient, or a purchase order must be open"
            }
          ],
          "ai_touchpoint_ref": null,
          "estimated_frequency": "daily",
          "notes": null
        }
      ]
    },
    {
      "workflow_id": "wf_002",
      "name": "Shipment to Invoice",
      "_section_render": ["customer", "dev"],
      "description": "Records shipment of completed goods and automatically generates a customer invoice synced to QuickBooks.",
      "steps": [
        {
          "step_id": "wf_002_s01",
          "sequence": 1,
          "name": "Record Shipment",
          "_label": "Shipping records goods as dispatched",
          "actor": { "type": "human", "role": "shipping_clerk" },
          "action": "record_shipment",
          "system": "erp_fulfillment_module",
          "inputs": [
            { "entity_ref": "ent_job_order", "state": "completed" }
          ],
          "outputs": [
            { "entity_ref": "ent_shipment", "state": "dispatched" }
          ],
          "rules": [
            {
              "rule_id": "r_005",
              "type": "required_field",
              "description": "Shipment must include tracking number and carrier"
            }
          ],
          "ai_touchpoint_ref": null,
          "estimated_frequency": "daily",
          "notes": null
        },
        {
          "step_id": "wf_002_s02",
          "sequence": 2,
          "name": "Auto-Generate Invoice",
          "_label": "System creates invoice from shipment",
          "actor": { "type": "system", "system_id": "int_001" },
          "action": "generate_invoice",
          "system": "erp_billing_module",
          "inputs": [
            { "entity_ref": "ent_shipment", "state": "dispatched" },
            { "entity_ref": "ent_purchase_order", "state": "in_production" }
          ],
          "outputs": [
            { "entity_ref": "ent_invoice", "state": "draft" }
          ],
          "rules": [
            {
              "rule_id": "r_006",
              "type": "validation",
              "description": "Invoice line items must match shipped quantities from job order"
            }
          ],
          "ai_touchpoint_ref": null,
          "estimated_frequency": "event_driven",
          "notes": "Triggers QuickBooks sync via int_001"
        }
      ]
    }
  ],

